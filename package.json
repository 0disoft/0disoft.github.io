{
  "name": "0disoft.github.io",
  "version": "0.0.163",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "scripts": {
    "dev": "bun run images && vite dev",
    "build": "bun run images && vite build && bun scripts/optimize-build-images.mjs",
    "images": "bun scripts/article-cover-images.mjs",
    "build:index": "bun run i18n && bun run build && bun run index",
    "preview": "vite preview",
    "index": "bun scripts/pagefind-index.mjs",
    "prepare": "svelte-kit sync || echo ''",
    "check": "bun run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bun run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck:fast": "bun run i18n && tsgo --noEmit",
    "i18n": "saylo-typegen --config saylo.config.json && saylo check --config saylo.config.json"
  },
  "dependencies": {
    "@0disoft/saylo-core": "^0.1.0-alpha.9",
    "@0disoft/saylo-svelte": "^0.1.0-alpha.9",
    "@tallyfin/browser": "./vendor/tallyfin-browser-0.0.0.tgz",
    "micromark": "^4",
    "mode-watcher": "^1.1.0"
  },
  "devDependencies": {
    "@0disoft/saylo-typegen": "^0.1.0-alpha.9",
    "@0disoft/saylo-vite": "^0.1.0-alpha.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@lucide/svelte": "^1.46.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.7",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "clsx": "^2.1.1",
    "mdsvex": "^0.12.8",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.83.0",
    "pagefind": "^1.5.2",
    "shadcn-svelte": "^1.7.0",
    "sharp": "0",
    "shiki": "^3.23.0",
    "simple-icons": "^16.31.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
